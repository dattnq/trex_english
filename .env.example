# Mẫu cấu hình, không chứa bí mật. Sao chép thành .env và tự điền.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
APP_URL=http://localhost:3000
DATABASE_URL=YOUR_SUPABASE_RUNTIME_CONNECTION_STRING
DIRECT_URL=YOUR_SUPABASE_DIRECT_OR_SESSION_CONNECTION_STRING
# Vercel Cron: set a random secret of at least 32 characters in Vercel; never NEXT_PUBLIC.
CRON_SECRET=
# Restore rehearsal: use a DIFFERENT, empty staging database only.
RESTORE_DATABASE_URL=
